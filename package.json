{
  "name": "doonam-public-collector",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "node collect.mjs",
    "build": "esbuild entry.ts --bundle --platform=node --format=esm --external:playwright --outfile=collect.mjs",
    "build:reservoirs": "esbuild reservoirs.ts --bundle --platform=node --format=esm --outfile=reservoirs.mjs",
    "collect:reservoirs": "node reservoirs.mjs"
  },
  "dependencies": {
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.1",
    "zod": "3.25.76"
  }
}
